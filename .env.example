# DAHAUS - Configuración build-time
# Copia este archivo a .env y ajusta los valores.
# El landing es estático: estas variables se embeben en el build (no en runtime).

# Dominio público (canonical, sitemap, datos estructurados y OG).
VITE_DOMAIN=https://www.dahausmerida.com

# WhatsApp de pedidos (código de país incluido, sin +).
VITE_WHATSAPP_NUMBER=584147009402
# Texto pre-cargado al hacer un pedido por delivery (URL-encoded).
VITE_WHATSAPP_DELIVERY_MESSAGE=%C2%A1Hola!+Me+gustar%C3%ADa+hacer+un+pedido
# Texto pre-cargado al reservar un evento (URL-encoded).
VITE_WHATSAPP_EVENT_MESSAGE=%C2%A1Hola!+Me+gustar%C3%ADa+reservar+una+fecha+para+un+evento

# Instagram.
VITE_INSTAGRAM_USER=@dahausmerida
VITE_INSTAGRAM_URL=https://www.instagram.com/dahausmerida?igsh=bzVmbnl1ZnJ6Mjhi

# Menús del cliente (PDF + página con favicon/título propios por cada uno).
VITE_MENU_HAMBURGUESAS_PATH=/menu-hamburguesas.pdf
VITE_MENU_HAMBURGUESAS_VIEW_PATH=/menu-hamburguesas.html
VITE_MENU_PLATOS_PATH=/menu-platos.pdf
VITE_MENU_PLATOS_VIEW_PATH=/menu-platos.html
VITE_MENU_BEBIDAS_PATH=/menu-bebidas.pdf
VITE_MENU_BEBIDAS_VIEW_PATH=/menu-bebidas.html
VITE_MENU_SIMPLEX_PATH=/menu-simplex.pdf
VITE_MENU_SIMPLEX_VIEW_PATH=/menu-simplex.html

# Crédito de desarrollo.
VITE_DEV_SITE_URL=https://desarrollosdigitalpower.com
VITE_DEV_SITE_NAME=DesarrollosDigitalPower.com

# Enlaces cortos de Google Maps por sede.
VITE_MAP_GARANA=https://maps.app.goo.gl/2ksuJQxwfqc3X2DS6
VITE_MAP_METROATLETIK=https://maps.app.goo.gl/kgUVixnvaWECi2Cq9
VITE_MAP_DECK=https://maps.app.goo.gl/1MXEtxf3R6kJDKBW7

# Mapas embebidos (iframer sin API key, consulta por nombre de lugar).
VITE_MAP_EMBED_GARANA=https://www.google.com/maps?q=Garana%20Padel%20Club%20M%C3%A9rida&output=embed
VITE_MAP_EMBED_METROATLETIK=https://www.google.com/maps?q=Metro%20Atletik%20M%C3%A9rida&output=embed