# DAHAUS - Configuración build-time
# Copia este archivo a .env y ajusta los valores.
# El landing es estático: estas variables se embeben en el build (no en runtime).

# Dominio público (canonical, sitemap, datos estructurados y OG).
VITE_DOMAIN=https://www.ejemplo.com

# WhatsApp de pedidos (código de país incluido, sin +).
VITE_WHATSAPP_NUMBER=580000000000

# Texto pre-cargado al hacer un pedido por delivery (URL-encoded).
VITE_WHATSAPP_DELIVERY_MESSAGE=Hola%2C+me+gustar%C3%ADa+hacer+un+pedido

# Texto pre-cargado al reservar un evento (URL-encoded).
VITE_WHATSAPP_EVENT_MESSAGE=Hola%2C+me+gustar%C3%ADa+reservar+una+fecha+para+un+evento

# Texto pre-cargado para pedidos de preventa (URL-encoded).
VITE_WHATSAPP_PREVENTA_MESSAGE=Hola%2C+me+gustar%C3%ADa+realizar+un+pedido+de+preventa

# Nombre del evento asociado a la preventa.
VITE_PREVENTA_EVENT_NAME=Nombre del evento

# Tasa de cambio utilizada por la aplicación.
VITE_EXCHANGE_RATE=1.00

# Instagram.
VITE_INSTAGRAM_USER=@nombre_usuario
VITE_INSTAGRAM_URL=https://www.instagram.com/nombre_usuario

# Menús del cliente (PDF + página con favicon/título propios por cada uno).
VITE_MENU_HAMBURGUESAS_PATH=/menu-hamburguesas.pdf
VITE_MENU_HAMBURGUESAS_VIEW_PATH=/menu-hamburguesas.html
VITE_MENU_PLATOS_PATH=/menu-platos.pdf
VITE_MENU_PLATOS_VIEW_PATH=/menu-platos.html
VITE_MENU_BEBIDAS_PATH=/menu-bebidas.pdf
VITE_MENU_BEBIDAS_VIEW_PATH=/menu-bebidas.html
VITE_MENU_SIMPLEX_PATH=/menu-simplex.pdf
VITE_MENU_SIMPLEX_VIEW_PATH=/menu-simplex.html

# Crédito de desarrollo.
VITE_DEV_SITE_URL=https://www.ejemplo.com
VITE_DEV_SITE_NAME=Nombre del desarrollador

# Enlaces cortos de Google Maps por sede.
VITE_MAP_GARANA=https://maps.app.goo.gl/XXXXXXXXXXXX
VITE_MAP_METROATLETIK=https://maps.app.goo.gl/XXXXXXXXXXXX
VITE_MAP_DECK=https://maps.app.goo.gl/XXXXXXXXXXXX

# Mapas embebidos (iframe sin API key, consulta por nombre de lugar).
VITE_MAP_EMBED_GARANA=https://www.google.com/maps?q=Nombre+del+local&output=embed
VITE_MAP_EMBED_METROATLETIK=https://www.google.com/maps?q=Nombre+del+local&output=embed

# Direcciones exactas (NAP) y coordenadas reales de cada sede.
# Las coordenadas alimentan el geo del JSON-LD para SEO local.
VITE_ADDRESS_GARANA=Direccion de ejemplo
VITE_ADDRESS_METRO=Direccion de ejemplo
VITE_GEO_GARANA_LAT=0.0000000
VITE_GEO_GARANA_LNG=0.0000000
VITE_GEO_METRO_LAT=0.0000000
VITE_GEO_METRO_LNG=0.0000000